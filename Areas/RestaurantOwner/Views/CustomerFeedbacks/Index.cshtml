@model IEnumerable<GoodFood.Models.CustomerFeedback>

<h2>Customer Feedback</h2>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Rating</th>
            <th>Comment</th>
            <th>Date</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5">No feedback yet.</td></tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerName</td>
                    <td>@item.Rating</td>
                    <td>@item.Comment</td>
                    <td>@item.CreatedDate.ToShortDateString()</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
