@model IEnumerable<GoodFood.Models.CartItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = Model?.Sum(item => item.MenuItem.Price * item.Quantity) ?? 0;
}

<h2 class="mb-4">My Cart</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
        <a asp-area="User" asp-controller="Menu" asp-action="Index" class="btn btn-link p-0">Browse Menu</a>.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MenuItem.Name</td>
                    <td>@item.MenuItem.Price.ToString("C")</td>
                    <td>
                        <div class="d-flex">
                            <form asp-controller="Cart" asp-action="Add" method="post" class="me-2">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">+</button>
                            </form>
                            <span class="px-2">@item.Quantity</span>
                            <form asp-controller="Cart" asp-action="Remove" method="post" class="ms-2">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">-</button>
                            </form>
                        </div>
                    </td>
                    <td>@(item.MenuItem.Price* item.Quantity).ToString("C")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Total: @total.ToString("C")</h4>
        <a asp-controller="Order" asp-action="Checkout" class="btn btn-success btn-lg">
            Proceed to Checkout
        </a>
    </div>
}
