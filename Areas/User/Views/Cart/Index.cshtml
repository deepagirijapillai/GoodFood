@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<GoodFood.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model != null && Model.Any())
{
<div class="container mt-4">
    <h2 class="mb-4">🛒 Your Cart</h2>

    <!-- Cart Items -->
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MenuItem.Name</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <!-- Decrease quantity -->
                            <form asp-area="User" asp-controller="Cart" asp-action="Remove" method="post" class="me-2">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">-</button>
                            </form>

                            <span class="px-2 fw-bold">@item.Quantity</span>

                            <!-- Increase quantity -->
                            <form asp-area="User" asp-controller="Cart" asp-action="Add" method="post" class="ms-2">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">+</button>
                            </form>
                        </div>
                    </td>
                    <td>₹@item.MenuItem.Price</td>
                    <td>₹@(item.Quantity* item.MenuItem.Price)</td>
                </tr>
            }
        </tbody>
    </table>


    <!-- Suggested Coupons -->
    <div class="mt-4">
        <h4>💡 Available Coupons</h4>
        @if (ViewBag.AvailableCoupons != null && ViewBag.AvailableCoupons.Count > 0)
        {
            <div class="list-group mb-3">
                @foreach (var coupon in ViewBag.AvailableCoupons)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action"
                            onclick="fillCoupon('@coupon.Code')">
                        <strong>@coupon.Code</strong> - @coupon.DiscountPercentage% OFF
                    </button>
                }
            </div>
        }
        else
        {
            <p class="text-muted">No coupons available at the moment.</p>
        }
    </div>

    <!-- Coupon Entry -->
    <form asp-action="ApplyCoupon" method="post" id="couponForm" class="mb-3">
        <div class="mb-3">
            <label for="couponCode" class="form-label">Enter Coupon Code</label>
            <div class="input-group">
                <input type="text" id="couponCode" name="couponCode" class="form-control" placeholder="Enter coupon code" />
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </div>
    </form>

    <!-- Applied Offer -->
    @if (ViewBag.CouponApplied != null)
    {
        <p class="text-success fw-bold">
            ✅ Coupon Applied: @ViewBag.CouponApplied.Code (@ViewBag.CouponApplied.DiscountPercentage% OFF)
        </p>
    }

    @if (ViewBag.OfferApplied != null)
    {
        <p class="text-info fw-bold">
            🎉 Restaurant Offer: @ViewBag.OfferApplied.Title (@ViewBag.OfferApplied.DiscountPercentage% OFF)
        </p>
    }

    <!-- Final Total -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (ViewBag.AppliedCoupon != null)
    {
        <p class="text-success">
            Applied Coupon: <strong>@ViewBag.AppliedCoupon</strong>
        </p>
    }

    <h4>Final Total (before discount): ₹@ViewBag.Total</h4>

    <!-- Place Order -->
    <form asp-controller="Order" asp-action="PlaceOrder" method="post" class="mt-3">
        <button type="submit" class="btn btn-primary btn-lg">
            ✅ Place Order
        </button>
    </form>
</div>
}

else
{
    <p class="text-muted">Your cart is empty.</p>
    <a asp-area="User" asp-controller="Menu" asp-action="Index" class="btn btn-outline-primary">
        Browse Menu
    </a>
}
<script>
    function fillCoupon(code) {
        // ✅ Puts the coupon code in the input field
        document.getElementById("couponCode").value = code;
    }
</script>
