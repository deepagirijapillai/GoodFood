@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Welcome to GoodFood!</h2>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">What would you like to do?</h5>
                    <p class="card-text">Access your cart, manage orders, or browse menu items.</p>
                    <a href="@Url.Action("Index", "Cart", new { area = "User" })" class="btn btn-primary btn-lg me-2">
                        View Cart
                    </a>
                    <a href="@Url.Action("Index", "Order", new { area = "User" })" class="btn btn-outline-secondary btn-lg">
                        My Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
